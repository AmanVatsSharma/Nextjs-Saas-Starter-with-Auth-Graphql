DATABASE_URL="postgresql://neondb_owner:VcfKSmY8GTL7@ep-raspy-heart-a5vi5ofg-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Frontend URL (for CORS in production)
FRONTEND_URL="https://yourdomain.com"

# Node Environment
NODE_ENV="development"

# Prisma
PRISMA_GENERATE_DATAPROXY="false"

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_ISSUER="your-saas-app"
JWT_AUDIENCE="your-saas-users"
