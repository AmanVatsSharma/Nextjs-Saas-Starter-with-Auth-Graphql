{
  "name": "nextjs-starter-graphql",
  "version": "0.1.0",
  "description": "Next.js GraphQL API with Auto-CRUD generation using Prisma and Pothos",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run generate && next build",
    "start": "next start",
    "lint": "next lint",
    "generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "clean:generated": "rm -rf generated prisma/generated",
    "type-check": "tsc --noEmit",
    "postinstall": "prisma generate",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@pothos/core": "^4.2.0",
    "@pothos/plugin-prisma": "^4.2.1",
    "@pothos/plugin-relay": "^4.6.2",
    "@pothos/plugin-scope-auth": "^4.1.5",
    "@pothos/plugin-validation": "^3.10.2",
    "@prisma/client": "^5.18.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.2",
    "critters": "^0.0.25",
    "graphql": "^16.9.0",
    "graphql-scalars": "^1.24.2",
    "graphql-yoga": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "next": "14.2.5",
    "prisma": "^5.18.0",
    "prisma-generator-pothos-codegen": "^0.7.1",
    "react": "^18",
    "react-dom": "^18",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.5",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "keywords": [
    "nextjs",
    "saas",
    "graphql",
    "prisma",
    "pothos",
    "autocrud",
    "typescript",
    "multi-tenancy",
    "authentication",
    "subscription",
    "billing"
  ]
}
